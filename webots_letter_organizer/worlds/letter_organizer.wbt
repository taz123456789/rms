Robot {
  translation 0 0 0.775
  rotation 0 0 1 0
  children [
    DEF BASE_VISUAL Shape {
      appearance PBRAppearance { baseColor 0.2 0.2 0.2  roughness 0.4  metalness 0.6 }
      geometry Cylinder { height 0.05  radius 0.08 }
    }
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1  anchor 0 0 0.025 }
      device [
        RotationalMotor { name "shoulder_yaw_motor"  acceleration 5  maxVelocity 1.5  maxTorque 50 }
        PositionSensor { name "shoulder_yaw_sensor" }
      ]
      endPoint Solid {
        translation 0 0 0.025
        children [
          DEF SHOULDER_VISUAL Shape {
            appearance PBRAppearance { baseColor 0.15 0.35 0.7  roughness 0.5  metalness 0.3 }
            geometry Cylinder { height 0.08  radius 0.05 }
          }
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 1 0  anchor 0 0 0.04 }
            device [
              RotationalMotor { name "shoulder_pitch_motor"  acceleration 4  maxVelocity 1.5  maxTorque 40 }
              PositionSensor { name "shoulder_pitch_sensor" }
            ]
            endPoint Solid {
              translation 0 0 0.04
              rotation 0 1 0 0
              children [
                DEF UPPER_ARM_VISUAL Pose {
                  translation 0 0 0.1
                  children [
                    Shape {
                      appearance PBRAppearance { baseColor 0.45 0.45 0.45  roughness 0.5  metalness 0.4 }
                      geometry Box { size 0.055 0.045 0.2 }
                    }
                  ]
                }
                HingeJoint {
                  jointParameters HingeJointParameters { axis 0 1 0  anchor 0 0 0.2 }
                  device [
                    RotationalMotor { name "elbow_pitch_motor"  acceleration 6  maxVelocity 2.0  maxTorque 30 }
                    PositionSensor { name "elbow_pitch_sensor" }
                  ]
                  endPoint Solid {
                    translation 0 0 0.2
                    rotation 0 1 0 0
                    children [
                      DEF FOREARM_VISUAL Pose {
                        translation 0 0 0.085
                        children [
                          Shape {
                            appearance PBRAppearance { baseColor 0.45 0.45 0.45  roughness 0.5  metalness 0.4 }
                            geometry Box { size 0.045 0.035 0.17 }
                          }
                        ]
                      }
                      Pose {
                        translation 0.04 0 0.01
                        rotation 0 1 0 -1.570795
                        children [
                          Camera {
                            name "letter_camera"
                            fieldOfView 1.4
                            width 640
                            height 480
                            near 0.01
                            far 0.5
                          }
                          Shape {
                            appearance PBRAppearance { baseColor 0.1 0.1 0.1 }
                            geometry Box { size 0.02 0.02 0.015 }
                          }
                        ]
                      }
                      HingeJoint {
                        jointParameters HingeJointParameters { axis 0 1 0  anchor 0 0 0.17 }
                        device [
                          RotationalMotor { name "wrist_pitch_motor"  acceleration 8  maxVelocity 2.5 }
                          PositionSensor { name "wrist_pitch_sensor" }
                        ]
                        endPoint Solid {
                          translation 0 0 0.17
                          rotation 0 1 0 0
                          children [
                            DEF WRIST_PITCH_VISUAL Shape {
                              appearance PBRAppearance { baseColor 0.15 0.35 0.7  roughness 0.5  metalness 0.3 }
                              geometry Cylinder { height 0.04  radius 0.022 }
                            }
                            HingeJoint {
                              jointParameters HingeJointParameters { axis 0 0 1  anchor 0 0 0.02 }
                              device [
                                RotationalMotor { name "wrist_roll_motor"  acceleration 10  maxVelocity 3.0  maxTorque 5 }
                                PositionSensor { name "wrist_roll_sensor" }
                              ]
                              endPoint Solid {
                                translation 0 0 0.02
                                children [
                                  DEF WRIST_ROLL_VISUAL Shape {
                                    appearance PBRAppearance { baseColor 0.25 0.25 0.25 }
                                    geometry Cylinder { height 0.03  radius 0.018 }
                                  }
                                  Pose {
                                    translation 0 0 0.025
                                    children [
                                      DEF GRIPPER_BASE_VISUAL Shape {
                                        appearance PBRAppearance { baseColor 0.4 0.4 0.4  roughness 0.4  metalness 0.5 }
                                        geometry Box { size 0.05 0.04 0.015 }
                                      }
                                      TouchSensor {
                                        name "pickup_sensor"
                                        boundingObject Box { size 0.05 0.04 0.015 }
                                      }
                                      SliderJoint {
                                        jointParameters JointParameters { position 0.020  axis 0 1 0 }
                                        device [
                                          LinearMotor { name "gripper_left_motor"  maxVelocity 0.06  maxPosition 0.020  maxForce 50 }
                                          PositionSensor { name "gripper_left_sensor" }
                                        ]
                                        endPoint Solid {
                                          translation 0 0.001 0.035
                                          children [
                                            DEF FINGER_VISUAL Shape {
                                              appearance PBRAppearance { baseColor 1 0.4 0  roughness 0.6  metalness 0.2 }
                                              geometry Box { size 0.012 0.010 0.050 }
                                            }
                                          ]
                                          name "left_finger"
                                          contactMaterial "gripper"
                                          boundingObject USE FINGER_VISUAL
                                          physics Physics { density -1  mass 0.050 }
                                        }
                                      }
                                      SliderJoint {
                                        jointParameters JointParameters { position 0.020  axis 0 -1 0 }
                                        device [
                                          LinearMotor { name "gripper_right_motor"  maxVelocity 0.06  maxPosition 0.020  maxForce 50 }
                                          PositionSensor { name "gripper_right_sensor" }
                                        ]
                                        endPoint Solid {
                                          translation 0 -0.001 0.035
                                          children [
                                            USE FINGER_VISUAL
                                          ]
                                          name "right_finger"
                                          contactMaterial "gripper"
                                          boundingObject USE FINGER_VISUAL
                                          physics Physics { density -1  mass 0.050 }
                                        }
                                      }
                                    ]
                                  }
                                ]
                                name "wrist_roll"
                                boundingObject USE WRIST_ROLL_VISUAL
                                physics Physics { density -1  mass 0.08 }
                              }
                            }
                          ]
                          name "wrist_pitch"
                          boundingObject USE WRIST_PITCH_VISUAL
                          physics Physics { density -1  mass 0.15 }
                        }
                      }
                    ]
                    name "forearm"
                    boundingObject USE FOREARM_VISUAL
                    physics Physics { density -1  mass 0.35 }
                  }
                }
              ]
              name "upper_arm"
              boundingObject USE UPPER_ARM_VISUAL
              physics Physics { density -1  mass 0.5 }
            }
          }
        ]
        name "shoulder"
        boundingObject USE SHOULDER_VISUAL
        physics Physics { density -1  mass 5.0 }
      }
    }
  ]
  name "letter_organizer_robot"
  boundingObject USE BASE_VISUAL
  controller "letter_sorter"
  supervisor TRUE
}
